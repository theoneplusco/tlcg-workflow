# TLCG Workflow — environment variables
#
# Copy to .env on the server and fill in. NEVER commit the real .env.
#   cp .env.example .env && chmod 600 .env
#
# Current values can be copied from Vercel:
#   Vercel Dashboard → tlcg-workflow → Settings → Environment Variables

# ── Server ────────────────────────────────────────────────────
PORT=3000
# Bind to localhost when a reverse proxy (nginx/Caddy) fronts the app.
# Use 0.0.0.0 only if you are exposing the port directly.
HOST=127.0.0.1
NODE_ENV=production

# ── Public URL / CORS ─────────────────────────────────────────
# Used for CORS and (via Apps Script Property APP_BASE_URL) email links.
APP_BASE_URL=https://workflow.tl-c.us
# Extra allowed browser origins, comma-separated. Usually empty, because the
# app is served same-origin behind Cloudflare.
APP_ALLOWED_ORIGINS=

# ── Apps Script backend URLs ──────────────────────────────────
# Every one of these has a hardcoded fallback in api/voucher.js, so the app
# still runs if they are unset — but set them so URLs can be rotated without
# editing source. Get each from: Apps Script → Deploy → Manage deployments.
TLCG_CASH_BACKEND_URL=
TLCG_CORE_BACKEND_URL=
TLCG_P2P_BACKEND_URL=

# Legacy aliases — only needed if you have not migrated to the names above.
# VOUCHER_BACKEND_URL=
# TLCGROUP_BACKEND_URL=
# PAYMENT_REQUEST_BACKEND_URL=

# ── Google — REQUIRED for Drive uploads ───────────────────────
# PREFER the base64 form under systemd. systemd's EnvironmentFile interprets
# backslash escapes, so the \n inside the raw JSON become literal 'n' and the
# PEM key is destroyed beyond repair. Base64 has nothing for it to mangle.
#
#   base64 -w0 service-account.json
#
# This is a real credential: keep .env at chmod 600 and never commit it.
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
# Fallback, only safe where nothing rewrites escapes (e.g. Vercel):
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Google Sheets / Drive IDs ─────────────────────────────────
MASTER_SPREADSHEET_ID=
DRIVE_VOUCHER_FOLDER_ID=
PURCHASE_REQUEST_FOLDER_ID=
PAYMENT_REQUEST_FOLDER_ID=
ACCEPTANCE_MINUTES_FOLDER_ID=

# ── Optional client-side Google config ────────────────────────
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=

# ── Mac Mini backend (Postgres + Redis + R2) ──────────────────
# Unset = the code default (localhost). PM2's ecosystem.config.cjs passes only variables that are set.
DATABASE_URL=postgres://localhost:5432/tlcg_workflow
REDIS_URL=redis://localhost:6379
# Login token secret. REQUIRED in production (no default; logins are refused without it).
JWT_SECRET=

# Workflows served from Postgres instead of GAS (comma list: cash,vouchers,files,p2p). Empty = all on GAS.
PG_WORKFLOWS=
# true = voucher and file actions refuse requests without a valid login token (401).
VOUCHER_REQUIRE_LOGIN=false

# ── Cloudflare R2 (voucher attachments, PG_WORKFLOWS=files) ───
# Account id from the Cloudflare dashboard; an R2 API token with read/write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (code default: tlcg-attachments).
R2_BUCKET_NAME=
# Public base URL of the bucket (code default: https://attachments.tl-c.us).
R2_PUBLIC_URL=

# ── One-way Postgres → Google Sheet copy of vouchers ──────────
# on = the worker copies sheet_outbox into the spreadsheet below. Anything else = off.
SHEETS_MIRROR=off
# Path to the mirror service-account JSON key (also read by scripts/import-vouchers.js).
SHEETS_MIRROR_KEY_FILE=secrets/sheets-mirror.json
# Target spreadsheet id (Voucher_History / Voucher_Current tabs). No default: unset = nothing queued, worker off.
VOUCHER_SPREADSHEET_ID=

# Sender for workflow emails (domain must be verified in Resend)
EMAIL_FROM=TLC Group Workflow <hello@tl-c.us>
