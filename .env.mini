# TLCG Workflow — .env for Mac Mini (theoneplus)
# Local Postgres + Redis, Cloudflare R2 + Resend (cloud)

# ── Local services ───────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/tlcg_workflow
REDIS_URL=redis://localhost:6379

# ── JWT (auth) ────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production

# ── Cloudflare R2 (set after creating the bucket) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tlcg-attachments
R2_PUBLIC_URL=https://attachments.tl-c.us

# ── Resend (email) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=TLC Group Workflow <noreply@tl-c.us>

# ── Keep during migration (GAS proxy fallback) ───────────────
TLCG_CASH_BACKEND_URL=
TLCG_P2P_BACKEND_URL=
TLCG_CORE_BACKEND_URL=

# ── Rate limiting ─────────────────────────────────────────────
API_RATE_LIMIT=300
