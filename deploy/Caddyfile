# Retired 2026-10-10: for the old workflow.tl-c.us app on Ubuntu. The live system is wf.tl-c.us (Mac Mini).
# Caddy site block for TLCG Workflow.
# Caddy obtains and renews TLS certificates automatically.
#
# Append to /etc/caddy/Caddyfile alongside your n8n block, then:
#   sudo systemctl reload caddy

workflow.tl-c.us {
    encode gzip zstd

    # Uploads: api/voucher.js declares a 10mb limit; allow headroom.
    request_body {
        max_size 12MB
    }

    # Cloudflare fronts this host, so the real client IP arrives in
    # CF-Connecting-IP. Pass it through as X-Forwarded-For so the app's
    # per-IP rate limit sees the visitor, not Cloudflare's edge.
    reverse_proxy 127.0.0.1:3000 {
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        # Long enough for Apps Script, which can be slow to respond.
        transport http {
            read_timeout 120s
        }
    }

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/tlcg-workflow.log
    }
}
