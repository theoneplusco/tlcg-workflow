# systemd unit for wf.tl-c.us on chinhnguyenserver (Ubuntu). See deploy/MOVE-TO-CHINHNGUYENSERVER.md.
# Runs next to the retired tlcg-workflow.service (workflow.tl-c.us, port 3001) without touching it.
#
# Install:  sudo cp /opt/tlcg-wf/deploy/tlcg-wf.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now tlcg-wf
# Logs:     journalctl -u tlcg-wf -f

[Unit]
Description=TLCG Workflow (wf.tl-c.us, Postgres)
Documentation=https://github.com/theoneplusco/tlcg-workflow
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=chinhnguyen
Group=chinhnguyen
WorkingDirectory=/opt/tlcg-wf
# server.js reads /opt/tlcg-wf/.env itself (dotenv); PORT=3002 and HOST=127.0.0.1 are set there.
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.js

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tlcg-wf

# Hardening: the app keeps its data in Postgres/Redis/R2 and writes nothing under /opt/tlcg-wf.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/tlcg-wf
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
